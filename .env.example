# This is an example .env file. Copy this to .env and fill in the values.
PRINTER_HOST=192.168.xxx.xxx
PRINTER_PORT=9100
PRINTER_PROFILE=TM-T88III
# Seconds to wait on a printer that isn't answering. Defaults to escpos's 60.
#PRINTER_TIMEOUT=60

# Which input sources to run, comma separated. Known sources: discord, http.
FAX_SOURCES=discord

# Required when "discord" is in FAX_SOURCES.
DISCORD_TOKEN=XXXX

# Required when "http" is in FAX_SOURCES. Callers send it as
# `Authorization: Bearer <token>`. There is no anonymous mode: this endpoint
# makes paper come out of a printer.
#FAX_HTTP_TOKEN=
#FAX_HTTP_HOST=127.0.0.1
#FAX_HTTP_PORT=8080